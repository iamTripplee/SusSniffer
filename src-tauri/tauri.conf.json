{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinGlance",
  "version": "0.6.3",
  "identifier": "com.iamtripplee.winglance",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "iamTripplee",
    "shortDescription": "Lightweight suspicious process monitor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QjEyNDQxNUYwOUFCNkEKUldScXF3bGZRU1N4aGtFOEhLc3FENWtLdUpORW9lQTR5YXpRY0lWalVzODhYSWdJQ2lMSnJXYVUK",
      "endpoints": ["https://github.com/iamTripplee/WinGlance/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
